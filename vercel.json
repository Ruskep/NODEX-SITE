{
  "cleanUrls": true,
  "redirects": [
    { "source": "/kb", "destination": "/wiki", "permanent": true }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
