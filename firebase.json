{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "nodeVersion": "18"
  },
  "hosting": {
    "public": "public",
    "404": "404.html",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {"source": "/", "destination": "/index.html"},
      {"source": "/news", "destination": "/pages/news.html"},
      {"source": "/seasons", "destination": "/pages/seasons.html"},
      {"source": "/players", "destination": "/pages/players.html"},
      {"source": "/content", "destination": "/pages/content.html"},
      {"source": "/useful", "destination": "/pages/useful.html"},
      {"source": "/kb", "destination": "/pages/kb.html"},
      {"source": "/mods", "destination": "/pages/mods.html"},
      {"source": "/links", "destination": "/pages/links.html"},
      {"source": "/map", "destination": "/pages/map.html"},
      {"source": "/player", "destination": "/pages/player.html"},
      {"source": "/season", "destination": "/pages/season.html"},
      {"source": "/partnership", "destination": "/pages/partnership.html"},
      {"source": "/admin", "destination": "/admin/index.html"},
      {"source": "/mystery", "destination": "/pages/mystery.html"},
      {"source": "/goose", "destination": "/pages/goose.html"}
    ],
    "headers": [
      {"source": "**/*.js", "headers": [{"key": "Cache-Control", "value": "no-cache, must-revalidate"}]},
      {"source": "**/*.json", "headers": [{"key": "Cache-Control", "value": "no-cache, must-revalidate"}]},
      {"source": "**/*.png", "headers": [{"key": "Cache-Control", "value": "no-cache, must-revalidate"}]},
      {"source": "**/*.zip", "headers": [{"key": "Cache-Control", "value": "no-cache, must-revalidate"}]},
      {"source": "**/*.xml", "headers": [{"key": "Cache-Control", "value": "no-cache, must-revalidate"}]},
      {"source": "robots.txt", "headers": [{"key": "Cache-Control", "value": "no-cache, must-revalidate"}]}
    ],
    "site": "nodex-mine"
  }
}
